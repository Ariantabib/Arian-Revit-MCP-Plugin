<Project Sdk="Microsoft.NET.Sdk">

  <!-- All tool implementations. Loaded by the plugin into a collectible AssemblyLoadContext so it can be hot-reloaded without restarting Revit. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Arian.RevitMcp.Tools</AssemblyName>
    <RootNamespace>Arian.RevitMcp.Tools</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSB3277;CS1591;CA1416;NU1701;CS0618;CS0612;CS8981;CS0168;CS0219;CS0162</NoWarn>
    <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit 2027\</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIIFC"><HintPath>$(RevitDir)RevitAPIIFC.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arian.RevitMcp\Arian.RevitMcp.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
